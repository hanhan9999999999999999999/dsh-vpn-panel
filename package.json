{
    "name":  "dsh-vpn-panel",
    "version":  "0.2.0",
    "description":  "DSH Settings section that controls a local proxy core: start/stop, node selection, real download measurement and config rebuild. Also teaches every agent session to reach the internet through that proxy (vpn_proxy tool + /dsh-vpn/ensure.json + an injected rule block), instead of hand-rolling proxy URLs. Bundles its own mihomo core, lifecycle scripts and a watchdog so it works standalone.",
    "type":  "module",
    "main":  "src/index.js",
    "exports":  {
                    ".":  "./src/index.js",
                    "./client":  "./lib/client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "src",
                  "lib",
                  "cordis.patch.yml",
                  "README.md",
                  "assets"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [

                                          ]
                           }
            },
    "keywords":  [
                     "dsh-plugin",
                     "deepseek-harness",
                     "vpn",
                     "proxy",
                     "mihomo",
                     "agent"
                 ],
    "scripts":  {
                    "test":  "node test/host-harness.mjs ./src/index.js 51997 && node test/agent-api.mjs 51996"
                },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-tools":  "*"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/dsh-tools":  {
                                                                "optional":  true
                                                            }
                             },
    "engines":  {
                    "node":  "^22.19.0 || \u003e=24.0.0"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/hanhan9999999999999999999/dsh-vpn-panel.git"
                   },
    "homepage":  "https://github.com/hanhan9999999999999999999/dsh-vpn-panel#readme",
    "license":  "MIT",
    "publishConfig":  {
                          "access":  "public"
                      },
    "bugs":  {
                 "url":  "https://github.com/hanhan9999999999999999999/dsh-vpn-panel/issues"
             }
}
