{
  "name": "dsh-vpn-panel",
  "version": "0.1.0",
  "description": "One-click VPN control panel for DSH: a Settings section that starts/stops the local mihomo proxy, picks nodes, measures speed and refreshes subscriptions.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "vpn",
    "proxy",
    "mihomo"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanhan9999999999999999999/dsh-vpn-panel.git"
  },
  "homepage": "https://github.com/hanhan9999999999999999999/dsh-vpn-panel#readme",
  "license": "MIT"
}
